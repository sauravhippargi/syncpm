// SyncPM Prisma schema — data model per architecture.md section 4
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String   @map("hashed_password")
  createdAt      DateTime @default(now()) @map("created_at")

  transcripts    Transcript[]
  jiraConnection JiraConnection?

  @@map("users")
}

model JiraConnection {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  cloudId      String   @map("cloud_id")
  siteUrl      String   @map("site_url")
  siteName     String   @map("site_name")
  projectKey   String?  @map("project_key")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("jira_connections")
}

model Transcript {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  title      String?
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  rawText    String   @map("raw_text")

  user        User         @relation(fields: [userId], references: [id])
  actionItems ActionItem[]

  @@map("transcripts")
}

model ActionItem {
  id           String    @id @default(cuid())
  transcriptId String    @map("transcript_id")
  description  String
  owner        String?
  dueDate      DateTime? @map("due_date")
  status       String    @default("open") // "open" | "done"
  isBlocker    Boolean   @default(false) @map("is_blocker")
  blockerNote  String?   @map("blocker_note")
  isApproved   Boolean   @default(false) @map("is_approved")

  transcript   Transcript    @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  jiraSyncLogs JiraSyncLog[]

  @@map("action_items")
}

model JiraSyncLog {
  id                String   @id @default(cuid())
  actionItemId      String   @map("action_item_id")
  jiraIssueKey      String?  @map("jira_issue_key")
  jiraUrl           String?  @map("jira_url")
  jiraProjectKey    String?  @map("jira_project_key")
  assigneeAccountId String?  @map("assignee_account_id")
  priority          String?
  status            String // "synced" | "failed"
  syncedAt          DateTime @default(now()) @map("synced_at")

  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)

  @@map("jira_sync_log")
}

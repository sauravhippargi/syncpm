# Copy this file to .env and fill in real values. Never commit .env.

# The app's own public origin (no trailing slash) — used to build URLs that
# outside services must be able to reach, like the Fathom webhook callback.
# Never derive this from the incoming request (new URL(request.url).origin);
# that reflects however the request actually arrived (direct, behind a
# tunnel, behind a proxy) and is unreliable.
#   Local dev: your tunnel's public URL (e.g. https://your-subdomain.ngrok-free.app)
#   Production: the real deployed domain (e.g. https://syncpm.vercel.app)
NEXT_PUBLIC_APP_URL=""

# Supabase Postgres — Connect dialog -> Transaction pooler (runtime, serverless-safe)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Postgres — Connect dialog -> Session pooler (migrations only)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Google Gemini API key (free tier) — wired up in Phase 1
GEMINI_API_KEY=""

# Auth.js (NextAuth v5) — signs/encrypts session JWTs. Generate with:
#   openssl rand -base64 33
AUTH_SECRET=""

# Jira Cloud REST API v3 — OAuth 2.0 (3LO), per-user connections.
# Register an OAuth app in the Atlassian Developer Console
# (https://developer.atlassian.com/console/myapps/) with the Jira platform
# REST API added, and callback URLs for both your dev and prod origins:
#   http://localhost:3000/api/integrations/jira/callback
#   https://your-deployed-domain/api/integrations/jira/callback
JIRA_OAUTH_CLIENT_ID=""
JIRA_OAUTH_CLIENT_SECRET=""
